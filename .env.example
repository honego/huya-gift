# 运行选项
HUYA_VERSION=v2
HUYA_GIFT_COUNT=0
HUYA_ROOM_URL=https://www.huya.com/your_room_id
HUYA_DAKA=true
HUYA_WELFARE=true
HUYA_WECHAT_PUSH=true
HUYA_LOCAL_DEBUG=false

# 登录配置。不要在此文件填写真实值并提交。
HUYA_COOKIE=
HUYA_COOKIE_FILE=huya_cookie.txt
HUYA_ACCOUNT=
HUYA_PASSWORD=

# 企业微信群机器人 Webhook 推送地址（可选）。
WX_WEBHOOK=

# Telegram Bot 推送配置（可选，话题 ID 仅用于 Forum Topic）。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=
